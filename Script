local function UpdateConfig()
    C.N = NB.Text
    local customRadius = tonumber(RBx.Text)
    if customRadius then C.R = customRadius end
end

NB.FocusLost:Connect(UpdateConfig)
RBx.FocusLost:Connect(UpdateConfig)

local function getT()
    UpdateConfig()
    local sN = string.lower(C.N)
    if sN == "" then return nil end
    for _, pl in ipairs(P:GetPlayers()) do
        if pl ~= LP then
            local pName = string.lower(pl.Name)
            local pDisp = string.lower(pl.DisplayName)
            if string.find(pName, sN) or string.find(pDisp, sN) then
                if pl.Character and pl.Character:FindFirstChild("Humanoid") and pl.Character.Humanoid.Health > 0 then
                    return pl.Character:FindFirstChild(C.P)
                end
            end
        end
    end
    return nil
end

RB.MouseButton1Click:Connect(function()
    UpdateConfig()
    tC = getT()
    RB.BackgroundColor3 = Color3.fromRGB(40, 200, 100)
    task.wait(0.3)
    RB.BackgroundColor3 = Color3.fromRGB(50, 120, 200)
end)

TB.MouseButton1Click:Connect(function()
    C.E = not C.E
    UpdateConfig()
    if C.E then
        TB.Text, TB.BackgroundColor3, tC = "Target Farm: ON", Color3.fromRGB(50, 200, 100), getT()
    else
        TB.Text, TB.BackgroundColor3, tC = "Target Farm: OFF", Color3.fromRGB(200, 50, 60), nil
    end
end)

RS.RenderStepped:Connect(function(dt)
    if C.E then
        if not tC or not tC.Parent or tC.Parent.Humanoid.Health <= 0 then
            tC = getT()
        end
        local mC = LP.Character
        if tC and mC and mC:FindFirstChild("HumanoidRootPart") then
            local rP = mC.HumanoidRootPart
            ang = ang + (C.S * dt)
            local tPos = tC.Position
            rP.CFrame = CFrame.new(Vector3.new(tPos.X + math.cos(ang)*C.R, tPos.Y, tPos.Z + math.sin(ang)*C.R), tPos)
            rP.Velocity = Vector3.new(0,0,0)
        end
    end
end)
