local function CreateTextBox(posY, placeholder, defaultText)
    local box = Instance.new("TextBox", MF)
    box.Size, box.Position = UDim2.new(0.9, 0, 0, 38), UDim2.new(0.05, 0, 0, posY)
    box.BackgroundColor3, box.PlaceholderText, box.Text = Color3.fromRGB(32, 32, 42), placeholder, defaultText
    box.TextColor3, box.Font, box.TextSize = Color3.fromRGB(255, 255, 255), Enum.Font.Gotham, 12
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", box) stroke.Color = Color3.fromRGB(60, 60, 80) stroke.Thickness = 1
    return box
end

